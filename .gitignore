# 系统杂项
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 本地预览产物
.serve/
_site/

# 依赖（若日后引入构建）
node_modules/

# Python 字节码（gen-manifest.py 跑一次就留一个）
__pycache__/
*.pyc

# 日志
*.log
npm-debug.log*

# 藏品原始素材：体积大，放这儿不进版本库
# 若要纳入版本管理，删掉下面这行即可
assets/img/*.psd
assets/img/*.tif
assets/audio/*.wav

# Obsidian 知识库：独立 git 仓库（magicwannago-lang/vault-template），不并入本站
agent/vault-template/

# Worker 本地密钥与状态
worker/.dev.vars
worker/.env
worker/.wrangler/

# 用户素材上传暂存（源图，处理进 assets/fox 后不入库）
IB/

# 验证截图，只留本地
notes/shot-*.png
